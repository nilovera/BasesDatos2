APP_NAME='Fixture 2030 API'
APP_VERSION='1.0.0'
APP_ENV='local'
API_HOST='127.0.0.1'
API_PORT='8000'
LOG_LEVEL='INFO'
DEPENDENCY_TIMEOUT_SECONDS='5'
DEFAULT_PAGE_SIZE='20'
MAX_PAGE_SIZE='100'

