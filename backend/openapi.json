          },
          "propagacion": {
            "type": "string",
            "enum": [
              "PENDIENTE",
              "PUBLICADA"
            ],
            "title": "Propagacion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eventoId",
          "partidoId",
          "secuencia",
          "tipo",
          "estadoPartido",
          "marcador",
          "versionPartido",
          "propagacion"
