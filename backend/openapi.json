          },
          "jugadorId": {
            "type": "string",
            "pattern": "^JUG-[0-9]{4}$",
            "title": "Jugadorid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo",
          "periodo",
          "minuto",
          "equipoId",
          "jugadorId"
        ],
        "title": "GolFields"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DEGRADED"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "const": "fixture2030-api",
            "title": "Service"
          },
          "mongodb": {
            "type": "string",
            "title": "Mongodb"
          },
          "redis": {
            "type": "string",
            "title": "Redis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "service",
          "mongodb",
          "redis"
        ],
        "title": "HealthResponse"
      },
      "InicioPartidoCommand": {
        "properties": {
          "ocurridoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurridoen"
          },
          "tipo": {
            "type": "string",
            "const": "INICIO_PARTIDO",
            "title": "Tipo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ocurridoEn",
          "tipo"
        ],
        "title": "InicioPartidoCommand"
      },
      "Marcador": {
        "properties": {
