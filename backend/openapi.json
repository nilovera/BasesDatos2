          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "ocurridoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurridoen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eventoId",
          "secuencia",
          "tipo",
          "ocurridoEn"
        ],
        "title": "EventoResumen"
      },
      "GolCommand": {
        "properties": {
          "tipo": {
            "type": "string",
            "const": "GOL",
            "title": "Tipo"
          },
          "periodo": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Periodo"
          },
          "minuto": {
            "type": "integer",
            "maximum": 150.0,
            "minimum": 0.0,
            "title": "Minuto"
          },
          "equipoId": {
            "type": "string",
            "pattern": "^EQ-[0-9]{2}$",
