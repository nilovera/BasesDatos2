          },
          "entraJugadorId": {
            "type": "string",
            "pattern": "^JUG-[0-9]{4}$",
            "title": "Entrajugadorid"
          },
          "ocurridoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurridoen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo",
          "periodo",
          "minuto",
          "equipoId",
          "saleJugadorId",
          "entraJugadorId",
          "ocurridoEn"
        ],
        "title": "SustitucionCommand"
      },
