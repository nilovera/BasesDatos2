          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "estadoPartido": {
            "type": "string",
            "title": "Estadopartido"
          },
          "marcador": {
            "$ref": "#/components/schemas/Marcador"
          },
          "versionPartido": {
            "type": "integer",
