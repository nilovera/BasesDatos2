{
  "openapi": "3.1.0",
  "info": {
    "title": "Fixture 2030 API",
    "description": "Núcleo deportivo en MongoDB, cache y sesiones en Redis, y comentarios en Cassandra.",
    "version": "0.4.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/partidos/{partidoId}": {
      "get": {
        "summary": "Get Match",
        "operationId": "get_match_api_v1_partidos__partidoId__get",
        "parameters": [
          {
            "name": "partidoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Partidoid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartidoResponse"
                }
              }
            },
            "headers": {
              "X-Cache": {
                "description": "Resultado Cache-Aside: HIT, MISS o BYPASS",
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS",
                    "BYPASS"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Identificador inválido"
          },
          "404": {
            "description": "Partido inexistente"
          },
          "503": {
            "description": "MongoDB no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/partidos/{partidoId}/eventos": {
      "get": {
        "summary": "Get Events",
        "operationId": "get_events_api_v1_partidos__partidoId__eventos_get",
        "parameters": [
          {
            "name": "partidoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Partidoid"
            }
          },
          {
            "name": "desdeSecuencia",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Desdesecuencia"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limite"
