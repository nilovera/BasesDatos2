            "title": "Local"
          },
          "visitante": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Visitante"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "local",
          "visitante"
        ],
        "title": "Marcador"
      },
      "PaginaEventos": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EventoResumen"
            },
            "type": "array",
            "title": "Items"
          },
          "siguienteSecuencia": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Siguientesecuencia"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "siguienteSecuencia"
        ],
        "title": "PaginaEventos"
      },
      "PartidoResponse": {
        "properties": {
          "partidoId": {
            "type": "string",
            "title": "Partidoid"
          },
          "localId": {
            "type": "string",
            "title": "Localid"
          },
          "visitanteId": {
            "type": "string",
            "title": "Visitanteid"
          },
          "inicioProgramado": {
            "type": "string",
            "format": "date-time",
            "title": "Inicioprogramado"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "marcador": {
            "$ref": "#/components/schemas/Marcador"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "partidoId",
          "localId",
          "visitanteId",
          "inicioProgramado",
          "estado",
          "marcador",
          "version"
        ],
        "title": "PartidoResponse"
      },
      "SesionCreate": {
        "properties": {
          "usuarioId": {
            "type": "string",
            "pattern": "^USR-[0-9]{4}$",
            "title": "Usuarioid"
          },
          "rol": {
            "type": "string",
            "enum": [
              "FAN",
              "OPERADOR",
              "ADMIN"
            ],
            "title": "Rol",
            "default": "FAN"
          },
          "ttlSegundos": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 60.0,
            "title": "Ttlsegundos",
            "default": 1800
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "usuarioId"
        ],
