{
  "openapi": "3.1.0",
  "info": {
    "title": "Fixture 2030 API",
    "description": "Núcleo deportivo en MongoDB con cache y sesiones temporales en Redis.",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/partidos/{partidoId}": {
      "get": {
        "summary": "Get Match",
        "operationId": "get_match_api_v1_partidos__partidoId__get",
        "parameters": [
          {
            "name": "partidoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Partidoid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartidoResponse"
                }
              }
            },
            "headers": {
              "X-Cache": {
                "description": "Resultado Cache-Aside: HIT, MISS o BYPASS",
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS",
                    "BYPASS"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Identificador inválido"
          },
          "404": {
            "description": "Partido inexistente"
          },
          "503": {
            "description": "MongoDB no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/partidos/{partidoId}/eventos": {
      "get": {
        "summary": "Get Events",
        "operationId": "get_events_api_v1_partidos__partidoId__eventos_get",
        "parameters": [
          {
            "name": "partidoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Partidoid"
            }
          },
          {
            "name": "desdeSecuencia",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Desdesecuencia"
            }
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limite"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaEventos"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Event",
        "operationId": "post_event_api_v1_partidos__partidoId__eventos_post",
        "parameters": [
          {
            "name": "partidoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Partidoid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/InicioPartidoCommand"
                  },
                  {
                    "$ref": "#/components/schemas/GolCommand"
                  },
                  {
                    "$ref": "#/components/schemas/SustitucionCommand"
                  },
                  {
                    "$ref": "#/components/schemas/CorreccionEventoCommand"
                  }
                ],
                "discriminator": {
                  "propertyName": "tipo",
                  "mapping": {
                    "INICIO_PARTIDO": "#/components/schemas/InicioPartidoCommand",
                    "GOL": "#/components/schemas/GolCommand",
                    "SUSTITUCION": "#/components/schemas/SustitucionCommand",
                    "CORRECCION_EVENTO": "#/components/schemas/CorreccionEventoCommand"
                  }
                },
                "title": "Event"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoConfirmado"
                }
              }
            }
          },
          "200": {
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "boolean",
                  "const": true
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventoConfirmado"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "description": "Comando inválido"
          },
          "404": {
            "description": "Partido o evento inexistente"
          },
          "409": {
            "description": "Conflicto de idempotencia, versión o estado"
          },
          "422": {
            "description": "Contrato inválido"
          },
          "503": {
            "description": "MongoDB no disponible"
          }
        }
      }
    },
    "/api/v1/sesiones": {
      "post": {
        "summary": "Create Session",
        "operationId": "create_session_api_v1_sesiones_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SesionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponse"
                }
              }
            }
          },
          "503": {
            "description": "Redis no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sesiones/{sesionId}": {
      "get": {
        "summary": "Get Session",
        "operationId": "get_session_api_v1_sesiones__sesionId__get",
        "parameters": [
          {
            "name": "sesionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sesionid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sesión inexistente o expirada"
          },
          "503": {
            "description": "Redis no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Session",
        "operationId": "delete_session_api_v1_sesiones__sesionId__delete",
        "parameters": [
          {
            "name": "sesionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sesionid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Sesión inexistente o expirada"
          },
          "503": {
            "description": "Redis no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sesiones/{sesionId}/renovacion": {
      "post": {
        "summary": "Renew Session",
        "operationId": "renew_session_api_v1_sesiones__sesionId__renovacion_post",
        "parameters": [
          {
            "name": "sesionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sesionid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SesionRenovacion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Sesión inexistente o expirada"
          },
          "503": {
            "description": "Redis no disponible"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CorreccionEventoCommand": {
        "properties": {
          "ocurridoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurridoen"
          },
          "tipo": {
            "type": "string",
            "const": "CORRECCION_EVENTO",
            "title": "Tipo"
          },
          "eventoOriginalId": {
            "type": "string",
            "pattern": "^EVE-[0-9]{6}$",
            "title": "Eventooriginalid"
          },
          "motivo": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Motivo"
          },
          "reemplazo": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GolFields"
              },
              {
                "$ref": "#/components/schemas/SustitucionFields"
              }
            ],
            "title": "Reemplazo",
            "discriminator": {
              "propertyName": "tipo",
              "mapping": {
                "GOL": "#/components/schemas/GolFields",
                "SUSTITUCION": "#/components/schemas/SustitucionFields"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ocurridoEn",
          "tipo",
          "eventoOriginalId",
          "motivo",
          "reemplazo"
        ],
        "title": "CorreccionEventoCommand"
      },
      "EventoConfirmado": {
        "properties": {
          "eventoId": {
            "type": "string",
