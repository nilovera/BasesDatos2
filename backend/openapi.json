          },
          "jugadorId": {
            "type": "string",
            "pattern": "^JUG-[0-9]{4}$",
            "title": "Jugadorid"
          },
          "ocurridoEn": {
            "type": "string",
            "format": "date-time",
            "title": "Ocurridoen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo",
          "periodo",
          "minuto",
          "equipoId",
          "jugadorId",
          "ocurridoEn"
        ],
        "title": "GolCommand"
      },
      "GolFields": {
        "properties": {
