# Copia de referencia SIN secretos. El .env real lo genera
# scripts/iniciar_monitoreo.ps1 a partir del .env de la API y no se versiona.

# Contraseña del usuario admin de Grafana (se genera al azar).
GRAFANA_ADMIN_PASSWORD=<se-genera-al-iniciar>

# URI del exporter de MongoDB (usuario del Hito 4, base de autenticación admin).
MONGODB_EXPORTER_URI=mongodb://<usuario>:<password>@host.docker.internal:27017/admin?directConnection=true
