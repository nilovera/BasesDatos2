# =============================================================================
# Hito 11 - Configuración de ejemplo del diagnóstico de conectividad
# =============================================================================
# Copiar este archivo como  config/conectividad.env  (NO se versiona) solo si
# se necesita sobrescribir algo. Si no existe, los scripts leen el .env de la
# API del Hito 10 (raíz del repositorio), que también está fuera de Git.
#
# Precedencia: --set CLAVE=VALOR > variables de entorno > config/conectividad.env
#              > .env de la API > valores por defecto.
#
# Ningún valor de este archivo es un secreto real. Las credenciales se
# completan solo en los archivos locales ignorados por Git.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
# Etiqueta libre que aparece en la evidencia (ej. "notebook Windows de Nico").
DIAG_ENTORNO=
# Límite de espera por prueba, en segundos (RNF5).
DIAG_TIMEOUT_SECONDS=3

# --- API del Hito 10 -----------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
# Log donde scripts/reiniciar_api.ps1 redirige la salida de la API.
API_LOG_FILE=logs/api.stderr.log

# --- MongoDB (Hito 4) ----------------------------------------------------------
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=fixture2030
MONGODB_AUTH_SOURCE=admin
MONGODB_USERNAME=<completar>
MONGODB_PASSWORD=
MONGODB_CONTAINER=fixture2030-mongodb
MONGO_EQUIPO_DEMO=EQ-01

# --- Neo4j (Hito 5) ------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_HTTP_URL=http://127.0.0.1:7474
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=<completar>
NEO4J_PASSWORD=
# Si el contenedor tiene otro nombre se detecta automáticamente por imagen.
NEO4J_CONTAINER=fixture2030-neo4j
NEO4J_PARTIDO_DEMO=PAR-0001

# --- Cassandra (Hito 6) ----------------------------------------------------------
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
CASSANDRA_TABLA=comentarios_por_partido
# El laboratorio no usa autenticación en Cassandra. Completar solo si se habilita.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CONTAINER=fixture2030-cassandra
CASSANDRA_PARTIDO_DEMO=PAR-0001
CASSANDRA_BUCKET_DEMO=203006131800

# --- Redis (Hito 7) --------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# El laboratorio no usa requirepass. Completar solo si se habilita.
REDIS_PASSWORD=
REDIS_CONTAINER=fixture2030-redis
# Sesión creada por scripts/preparar_sesiones_redis.ps1 (Hito 10).
REDIS_SESION_DEMO=SES-API-0001

# --- InfluxDB 3 (Hito 8) ----------------------------------------------------------
INFLUXDB_URL=http://127.0.0.1:8181
INFLUXDB_TOKEN=
INFLUXDB_DETAIL_DATABASE=fixture2030_detalle
INFLUXDB_HISTORICAL_DATABASE=fixture2030_historico
INFLUXDB_CONTAINER=fixture2030-influxdb
INFLUX_PARTIDO_DEMO=PAR-0001
INFLUX_DESDE=2030-06-13T20:00:00Z
INFLUX_HASTA=2030-06-13T20:01:00Z
INFLUX_TABLA_DETALLE=estadisticas_equipo
INFLUX_TABLA_HISTORICO=resumen_equipo_minuto

# --- InterSystems IRIS (Hito 9) ---------------------------------------------------
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_PORTAL_PORT=52773
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=
IRIS_CONTAINER=fixture2030-iris
IRIS_PARTIDO_DEMO=PAR-0001
