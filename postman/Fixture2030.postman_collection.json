  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Incluye X-Request-ID\", function () { pm.expect(pm.response.headers.has(\"X-Request-ID\")).to.eql(true); });",
              "pm.test(\"Tiempo menor a 10 segundos\", function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
            ]
          }
        }
      ]
    },
